{
  "name": "igne-agency/laravel-bootstrap",
  "description": "A comprehensive Laravel application bootstrap package for local development with automatic dependency management, database setup, and multi-server support (Herd, Sail, Laravel). Development only - not for production use.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "laravel",
    "bootstrap",
    "development",
    "local-development",
    "herd",
    "sail",
    "dev-tools"
  ],
  "authors": [
    {
      "name": "Rick Blanksma",
      "email": "rick@igne.nl"
    }
  ],
  "require": {
    "php": "^8.3",
    "composer/semver": "^3.4",
    "illuminate/console": "^13.0",
    "illuminate/database": "^13.0",
    "illuminate/pipeline": "^13.0",
    "illuminate/process": "^13.0",
    "illuminate/support": "^13.0",
    "laravel/prompts": "^0.3.21"
  },
  "require-dev": {
    "laravel/pint": "^1.27",
    "mockery/mockery": "^1.6",
    "orchestra/testbench": "^11.0",
    "pestphp/pest": "^4.0",
    "pestphp/pest-plugin-laravel": "^4.0"
  },
  "autoload": {
    "psr-4": {
      "Igne\\LaravelBootstrap\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Igne\\LaravelBootstrap\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Igne\\LaravelBootstrap\\BootstrapServiceProvider"
      ]
    }
  },
  "scripts": {
    "test": "pest",
    "test-coverage": "pest --coverage"
  },
  "config": {
    "sort-packages": true,
    "preferred-install": "dist",
    "optimize-autoloader": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
